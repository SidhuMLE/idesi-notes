{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Zurich",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all Capacitor packages together — they must all be on the same major version",
      "groupName": "Capacitor",
      "matchPackagePrefixes": ["@capacitor/"]
    },
    {
      "description": "Group all testing libraries together",
      "groupName": "Testing",
      "matchPackagePrefixes": ["@testing-library/", "vitest", "@vitest/", "@playwright/"]
    },
    {
      "description": "Group all Tailwind packages together",
      "groupName": "Tailwind",
      "matchPackagePrefixes": ["tailwindcss", "@tailwindcss/"]
    },
    {
      "description": "Automerge patch and minor updates that pass CI",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
